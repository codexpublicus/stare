---
import JsonLd from '../components/JsonLd.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SOURCES, coverage, decisionsLabel, indexVersion, yearSpan } from '../lib/collection.js';
import { webSite } from '../lib/jsonld.js';
import { caseRouteScript } from '../lib/caseroute.js';
import { DATA_URL, INDEX_URL } from '../../public/js/sources.js';
import { BOOT_TIMEOUT_MS, bootGuardScript } from '../lib/bootguard.js';
import '../styles/theme.css';
import '../styles/layout.css';
import '../styles/reader.css';
import '../styles/suggest.css';
import Brand from '../components/Brand.astro';
import SiteHead from '../components/SiteHead.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<SiteHead />
		<title>stare.pub — U.S. Case Law Citation Resolution</title>
		<meta name="description" content="Free, serverless U.S. case law citation resolution. Look up any case by citation, all in your browser, with no server and no account." />
		<meta property="og:title" content="§tare.pub — Free U.S. Case Law Lookup" />
		<meta property="og:description" content={`Resolve legal citations to full case text and original scanned pages. ${coverage}. No server, no account.`} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://stare.pub" />
		<meta property="og:image" content="https://stare.pub/og-image.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="§tare.pub — Free U.S. Case Law Lookup" />
		<meta name="twitter:description" content={`Resolve legal citations to full case text and original scanned pages. ${decisionsLabel}. Serverless. Actually.`} />
		<JsonLd data={webSite()} />
		<script is:inline>
			try {
				var theme = localStorage.getItem('stare-theme');
				if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			} catch(e) {}
		</script>
		<!-- A case in the hash opens on the reader's loading shell, not the landing (layout.css),
		     and starts the WASM and the data hosts' connections with the HTML (caseroute.js). -->
		<script is:inline set:html={caseRouteScript([INDEX_URL, DATA_URL])}></script>
		<!-- If main.js or a module it imports fails to load, say so instead of "Loading..." forever (#265). -->
		<script is:inline set:html={bootGuardScript({ targets: ['status-bar', 'landing-status'], what: 'The reader', errorClass: 'error', timeout: BOOT_TIMEOUT_MS })}></script>
	</head>
	<body>
		<!-- Landing state -->
		<div id="landing" class="landing">
			<button class="landing-theme-toggle" id="landing-theme-btn" title="Toggle dark mode">&#9790;</button>
			<div class="landing-hero">
				<h1 class="landing-brand"><Brand variant="hero" /></h1>
				<p class="landing-tagline">Free, open U.S. case law lookup</p>
				<p class="landing-desc">Resolve legal citations to full case text and original scanned pages.<br>No server. No account. Just static files and your browser.</p>
			</div>

			<p class="landing-input-hint">Enter a citation, or words to search for</p>
			<form id="landing-form" class="landing-form">
				<div class="suggest-anchor">
					<input id="landing-input" type="text" placeholder="31 A.2d 647" autocomplete="off" spellcheck="false" aria-label="Citation or words to search for" />
					<ul id="landing-suggest" class="suggest hidden" aria-label="Suggestions"></ul>
				</div>
				<!-- One button for both (D163): its label follows the text, a citation or words (boxroute.js). -->
				<button type="submit" id="landing-btn" class="route-btn" data-goes="search"><span class="route-label route-search">Search</span><span class="route-label route-cite">Open citation</span></button>
			</form>
			<span id="landing-suggest-status" class="sr-only" aria-live="polite"></span>
			<span id="landing-route-status" class="sr-only" aria-live="polite"></span>
			<div id="landing-status" class="status-line"></div>
			<div id="landing-wasm-progress"></div>

			<div class="landing-examples">
				<span class="landing-examples-label">Try:</span>
				<a href="#a2d/31/647-01" class="landing-example">31 A.2d 647</a>
				<a href="#a2d/31/662-01" class="landing-example">31 A.2d 662</a>
				<a href="#a2d/31/693-01" class="landing-example">31 A.2d 693</a>
			</div>

			<div class="landing-features">
				<div class="landing-feature">
					<div class="landing-feature-icon">&#128214;</div>
					<div class="landing-feature-text">
						<strong id="collection-cases" data-index-version={indexVersion}>{decisionsLabel}</strong>
						<span>{yearSpan}, from {SOURCES}</span>
					</div>
				</div>
				<div class="landing-feature">
					<div class="landing-feature-icon">&#128196;</div>
					<div class="landing-feature-text">
						<strong>Original page scans</strong>
						<span>View the actual reporter pages alongside case text</span>
					</div>
				</div>
				<div class="landing-feature">
					<div class="landing-feature-icon">&#128274;</div>
					<div class="landing-feature-text">
						<strong>Serverless. Actually.</strong>
						<span>No backend — your browser does the work</span>
					</div>
				</div>
			</div>

			<div class="landing-tools">
				<a href="/check" class="landing-tool">
					<div class="landing-tool-icon">&#128203;</div>
					<div class="landing-tool-text">
						<strong>Check a brief</strong>
						<span>Paste any legal text. We'll find every citation and tell you which ones we can resolve to the full case.</span>
					</div>
				</a>
				<a href="/search/" class="landing-tool">
					<div class="landing-tool-icon">&#128269;</div>
					<div class="landing-tool-text">
						<strong>Search case law</strong>
						<span>Find decisions by the words in their text or their names, filtered by court and year.</span>
					</div>
				</a>
				<a href="mailto:info@codexpublicus.org?subject=stare.pub%20CLI%20%2F%20AI%20skill%20alpha%20access&body=I'd%20like%20to%20try%20the%20CLI%20%2F%20AI%20skill%20when%20available." class="landing-tool coming-soon">
					<div class="landing-tool-icon">&#9000;</div>
					<div class="landing-tool-text">
						<strong>CLI + AI skill <span class="coming-soon-badge">request alpha</span></strong>
						<span>Check citations from your terminal or let your AI assistant verify case references while you write.</span>
					</div>
				</a>
			</div>

			<div class="landing-links">
				<a href="/about" class="landing-link">About this project</a>
			</div>

			<SiteFooter variant="landing" />
		</div>

		<!-- Resolved state (hidden initially) -->
		<div id="resolved" class="hidden">
			<div class="topbar" id="topbar">
				<a href="/" class="topbar-brand"><Brand /></a>
				<span class="topbar-divider">|</span>
				<span class="topbar-cite topbar-editable" id="topbar-cite" title="Search another citation"></span>
				<input class="topbar-cite-input hidden" id="topbar-cite-input" type="text" autocomplete="off" spellcheck="false" aria-label="Citation or words to search for" />
				<button type="button" id="topbar-go" class="route-btn topbar-go hidden" data-goes="search"><span class="route-label route-search">Search</span><span class="route-label route-cite">Open citation</span></button>
				<ul id="topbar-suggest" class="suggest topbar-suggest hidden" aria-label="Suggestions"></ul>
				<span id="topbar-suggest-status" class="sr-only" aria-live="polite"></span>
				<span id="topbar-route-status" class="sr-only" aria-live="polite"></span>
				<span class="topbar-case" id="topbar-case"></span>
				<button id="prev-btn" class="topbar-nav" title="Previous case" disabled>&#9664;</button>
				<button id="next-btn" class="topbar-nav" title="Next case" disabled>&#9654;</button>
				<button id="theme-btn" class="theme-toggle" title="Toggle dark mode">&#9790;</button>
			</div>
			<div class="layout">
				<div class="main">
					<!-- The page views' tabs show once the case says it has scans (main.js). -->
					<div class="view-tabs">
						<div class="view-tab active" id="tab-reader">Reader</div>
						<div class="view-tab hidden" id="tab-pdf">Archival PDF</div>
						<div class="view-tab hidden" id="tab-pages">Raw Scans</div>
					</div>
					<!-- A provisional key's notice, on a /k/ address (#283, main.js). -->
					<p id="key-notice" class="key-notice hidden" role="note"></p>
					<div class="main-body">
						<!-- Over the top of the reader, so showing or hiding them moves nothing (#260). -->
						<div class="load-status">
							<div id="status-bar" class="status-line hidden"></div>
							<div id="wasm-progress"></div>
						</div>
						<div class="main-content">
							<div id="reader"></div>
							<div id="pdf-viewer" class="hidden"></div>
							<div id="page-viewer" class="hidden"></div>
						</div>
					</div>
				</div>
				<div class="sidebar" id="sidebar"></div>
			</div>
		</div>
		<button class="sidebar-toggle hidden" id="sidebar-toggle">&#9776;</button>

		<script is:inline type="module" src="/js/main.js"></script>
	</body>
</html>
