---
import '../styles/theme.css';
import '../styles/layout.css';
import '../styles/reader.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>stare.pub — U.S. Case Law Citation Resolution</title>
		<meta name="description" content="Free, serverless U.S. case law citation resolution. Look up any case by citation — all client-side, no server, no tracking." />
		<meta property="og:title" content="§tare.pub — Free U.S. Case Law Lookup" />
		<meta property="og:description" content="Resolve legal citations to full case text and original scanned pages. 6.7 million cases, 1658–2018. No server, no tracking, no account." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://stare.pub" />
		<meta property="og:image" content="https://stare.pub/og-image.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="§tare.pub — Free U.S. Case Law Lookup" />
		<meta name="twitter:description" content="Resolve legal citations to full case text and original scanned pages. 6.7 million cases. Serverless. Actually." />
		<script is:inline>
			try {
				var theme = localStorage.getItem('stare-theme');
				if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			} catch(e) {}
		</script>
	</head>
	<body>
		<!-- Landing state -->
		<div id="landing" class="landing">
			<button class="landing-theme-toggle" id="landing-theme-btn" title="Toggle dark mode">&#9790;</button>
			<div class="landing-hero">
				<h1 class="landing-brand">§tare.pub</h1>
				<p class="landing-tagline">Free, open U.S. case law lookup</p>
				<p class="landing-desc">Resolve legal citations to full case text and original scanned pages.<br>No server. No tracking. No account. Just static files and your browser.</p>
			</div>

			<p class="landing-input-hint">Enter a citation</p>
			<form id="landing-form" class="landing-form">
				<input id="landing-input" type="text" placeholder="31 A.2d 647" autocomplete="off" />
				<button type="submit" id="landing-btn">Resolve</button>
			</form>
			<div id="landing-status" class="status-line"></div>

			<div class="landing-examples">
				<span class="landing-examples-label">Try:</span>
				<a href="#a2d/31/647-01" class="landing-example">31 A.2d 647</a>
				<a href="#a2d/31/662-01" class="landing-example">31 A.2d 662</a>
				<a href="#a2d/31/693-01" class="landing-example">31 A.2d 693</a>
			</div>

			<div class="landing-features">
				<div class="landing-feature">
					<div class="landing-feature-icon">&#128214;</div>
					<div class="landing-feature-text">
						<strong>6.7 million cases</strong>
						<span>1658–2018, from the Harvard Caselaw Access Project</span>
					</div>
				</div>
				<div class="landing-feature">
					<div class="landing-feature-icon">&#128196;</div>
					<div class="landing-feature-text">
						<strong>Original page scans</strong>
						<span>View the actual reporter pages alongside case text</span>
					</div>
				</div>
				<div class="landing-feature">
					<div class="landing-feature-icon">&#128274;</div>
					<div class="landing-feature-text">
						<strong>Serverless. Actually.</strong>
						<span>No backend — your browser does the work</span>
					</div>
				</div>
			</div>

			<div class="landing-tools">
				<a href="/check" class="landing-tool">
					<div class="landing-tool-icon">&#128203;</div>
					<div class="landing-tool-text">
						<strong>Check a brief</strong>
						<span>Paste any legal text. We'll find every citation and tell you which ones we can resolve to the full case.</span>
					</div>
				</a>
				<a href="mailto:info@stare.pub?subject=stare.pub%20CLI%20%2F%20AI%20skill%20alpha%20access&body=I'd%20like%20to%20try%20the%20CLI%20%2F%20AI%20skill%20when%20available." class="landing-tool coming-soon">
					<div class="landing-tool-icon">&#9000;</div>
					<div class="landing-tool-text">
						<strong>CLI + AI skill <span class="coming-soon-badge">request alpha</span></strong>
						<span>Check citations from your terminal or let your AI assistant verify case references while you write.</span>
					</div>
				</a>
			</div>

			<div class="landing-links">
				<a href="/about" class="landing-link">About this project</a>
			</div>

			<div class="landing-footer">
				Built with &hearts; by <a href="https://github.com/lokkju" target="_blank" rel="noopener">lokkju</a>
				<span class="landing-link-sep">&middot;</span>
				<a href="mailto:info@stare.pub">info@stare.pub</a>
				<span class="landing-link-sep">&middot;</span>
				<a href="https://x.com/lokkju" target="_blank" rel="noopener">@lokkju</a>
			</div>
		</div>

		<!-- Resolved state (hidden initially) -->
		<div id="resolved" class="hidden">
			<div class="topbar" id="topbar">
				<a href="/" class="topbar-brand">§tare.pub</a>
				<span class="topbar-divider">|</span>
				<span class="topbar-cite topbar-editable" id="topbar-cite" title="Search another citation"></span>
				<input class="topbar-cite-input hidden" id="topbar-cite-input" type="text" autocomplete="off" />
				<span class="topbar-case" id="topbar-case"></span>
				<button id="prev-btn" class="topbar-nav" title="Previous case" disabled>&#9664;</button>
				<button id="next-btn" class="topbar-nav" title="Next case" disabled>&#9654;</button>
				<button id="theme-btn" class="theme-toggle" title="Toggle dark mode">&#9790;</button>
			</div>
			<div id="status-bar" class="status-line hidden"></div>
			<div class="layout">
				<div class="main">
					<div class="view-tabs">
						<div class="view-tab active" id="tab-reader">Reader</div>
						<div class="view-tab" id="tab-pages">Original Pages</div>
					</div>
					<div class="main-content">
						<div id="reader"></div>
						<div id="page-viewer" class="hidden"></div>
					</div>
				</div>
				<div class="sidebar" id="sidebar"></div>
			</div>
		</div>
		<button class="sidebar-toggle hidden" id="sidebar-toggle">&#9776;</button>

		<script is:inline type="module" src="/js/main.js"></script>
	</body>
</html>
