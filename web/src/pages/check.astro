---
import SiteFooter from '../components/SiteFooter.astro';
import { casesLabel } from '../lib/collection.js';
import '../styles/theme.css';
import '../styles/layout.css';
import '../styles/reader.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Check Citations — stare.pub</title>
		<meta name="description" content="Paste a legal brief and check all citations against the Harvard Caselaw Access Project corpus." />
		<meta property="og:title" content="Check Citations — §tare.pub" />
		<meta property="og:description" content={`Paste a legal brief and check all citations against ${casesLabel} from the Harvard Caselaw Access Project.`} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://stare.pub/check" />
		<meta property="og:image" content="https://stare.pub/og-image.png" />
		<script is:inline>
			try {
				var theme = localStorage.getItem('stare-theme');
				if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			} catch(e) {}
		</script>
		<style>
			.check-container { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem; }
			.check-header { margin-bottom: 1.5rem; }
			.check-header h1 { font-family: var(--font-text); font-size: 1.5rem; font-weight: 600; margin-bottom: 0.25rem; }
			.check-header p { font-size: 0.9rem; color: var(--text-secondary); }
			.check-input-area { margin-bottom: 1rem; }
			.check-textarea {
				width: 100%; min-height: 200px; padding: 16px;
				font-family: var(--font-text); font-size: 15px; line-height: 1.7;
				border: 2px solid var(--border); border-radius: 8px;
				background: var(--bg); color: var(--text);
				resize: vertical;
			}
			.check-textarea:focus { outline: none; border-color: var(--link); }
			.check-actions { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1.5rem; }
			.check-btn {
				padding: 10px 24px; background: var(--topbar-bg); color: var(--topbar-text);
				border: none; border-radius: 6px; font-size: 14px; font-weight: 500;
				cursor: pointer; transition: opacity 0.15s;
			}
			.check-btn:hover { opacity: 0.85; }
			.check-btn:disabled { opacity: 0.5; cursor: wait; }
			.check-status { font-size: 0.85rem; color: var(--text-secondary); }
			.check-status.check-error { color: var(--error-text); background: var(--error-bg); border: 1px solid var(--error-border); border-radius: 6px; padding: 6px 10px; }
			.check-results { display: none; }
			.check-results.visible { display: flex; gap: 1.5rem; }
			.check-text-panel { flex: 1; min-width: 0; }
			.check-cite-panel { width: 280px; min-width: 280px; background: var(--bg-alt); border-radius: 8px; padding: 16px; font-size: 13px; max-height: 60vh; overflow-y: auto; }
			.check-rendered {
				font-family: var(--font-text); font-size: 15px;
				line-height: 1.8; color: var(--text-body); padding: 16px;
				border: 1px solid var(--border); border-radius: 8px;
				background: var(--bg); min-height: 100px;
			}
			.check-rendered p { margin-bottom: 1rem; }
			.check-summary { margin-bottom: 12px; font-size: 12px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
			@media (max-width: 768px) {
				.check-results.visible { flex-direction: column; }
				.check-cite-panel { width: 100%; min-width: 0; max-height: none; }
			}
		</style>
	</head>
	<body>
		<div class="page-topbar"><a href="/">§tare.pub</a><button class="page-theme-toggle" id="page-theme-btn" title="Toggle dark mode">&#9790;</button></div>
		<div class="check-container">
			<div class="check-header">
				<h1>Check Citations</h1>
				<p>Paste a legal brief or any text containing case citations. We'll identify each citation and check whether we can resolve it to the full case text. When a citation gives the same decision in two reporters and we hold only one, the other opens the case we hold, marked as inferred from the citing text; if the two open different cases, both are flagged for review. A case from a volume we don't hold links to CourtListener and Google Scholar, where it may be, and a statute or regulation links to its text where it's published.</p>
			</div>

			<div class="check-input-area">
				<textarea id="check-input" class="check-textarea" placeholder="Paste your brief here...

Example: The court in D'Elia & Marks Co. v. Lyon, 31 A.2d 647 (D.C. Mun. Ct. App. 1943), held that residence is the test for attachment jurisdiction. See also Robinson v. Morrison, 2 App.D.C. 105; Barney v. Oelrichs, 138 U.S. 529."></textarea>
			</div>

			<div class="check-actions">
				<button id="check-btn" class="check-btn">Check Citations</button>
				<span id="check-status" class="check-status" role="status" aria-live="polite"></span>
			</div>
			<div id="check-wasm-progress"></div>

			<div id="check-results" class="check-results">
				<div class="check-text-panel">
					<div id="check-rendered" class="check-rendered"></div>
				</div>
				<div class="check-cite-panel">
					<div class="check-summary" id="check-summary"></div>
					<div id="check-cite-list"></div>
				</div>
			</div>

			<a href="/" class="back-link">&larr; Back to stare.pub</a>
			<SiteFooter />
		</div>

		<script is:inline type="module">
			import { detectCitations, checkCitations, occurrence, escapeHtml, renderTextHtml, citedListHtml, groupCitations, citationSummary, seqSuffix } from '/js/citations.js';
			import { attachCiteNav } from '/js/citenav.js';
			import { preloadWasm, WasmLoadError } from '/js/wasm.js';
			import { showWasmProgress } from '/js/wasmbar.js';

			const input = document.getElementById('check-input');
			const btn = document.getElementById('check-btn');
			const status = document.getElementById('check-status');
			const results = document.getElementById('check-results');
			const rendered = document.getElementById('check-rendered');
			const citeList = document.getElementById('check-cite-list');
			const summary = document.getElementById('check-summary');
			// The list wired to the text (citenav.js), for the latest check.
			let citeNav = null;

			btn.addEventListener('click', async () => {
				const text = input.value.trim();
				if (!text) return;

				btn.disabled = true;
				status.classList.remove('check-error');
				status.textContent = 'Scanning for citations...';
				results.classList.remove('visible');
				citeNav?.destroy();
				citeNav = null;
				// The loading bar, if the WASM isn't ready; it reports a load
				// failure itself, with a Retry button that reruns the check.
				showWasmProgress(document.getElementById('check-wasm-progress'), { onRetryReady: () => btn.click() });

				try {
					const citations = await detectCitations(text);
					if (citations.length === 0) {
						status.textContent = 'No citations detected in the text.';
						btn.disabled = false;
						return;
					}

					status.textContent = `Found ${citations.length} citations. Checking availability...`;

					// Check availability, once per citation (a short form once
					// per antecedent, through it): the volume in the manifest,
					// then the page in the volume's index.
					const checked = await checkCitations(citations);
					// One list entry per cited case (#159); this also tags each
					// entry with its group, which the text's citations carry.
					const groups = groupCitations(citations, checked);

					// Build citation map for highlighting
					const citationMap = new Map();
					for (const c of checked) {
						citationMap.set(c.key, c);
					}

					// Render highlighted text; detectCitations' offsets are into `text`
					rendered.innerHTML = renderTextHtml(text, citations.map(occurrence), citationMap, escapeHtml)
						.map(p => `<p>${p}</p>`)
						.join('');

					// Render cite list: cases and statutes counted apart, and bare
					// section references neither counted nor listed.
					summary.textContent = citationSummary(checked);

					// Held here, then statutes linked to their text, then cases
					// to look for elsewhere (CourtListener, Google Scholar), then
					// statutes with no link, then the rest.
					const caseHref = (c) => `/#${c.slug}/${c.volume}/${c.page}${seqSuffix(c.seq) || '-01'}`;
					citeList.innerHTML = citedListHtml(groups, caseHref, '');

					results.classList.add('visible');
					citeNav = attachCiteNav({ list: citeList, text: rendered });
					status.textContent = '';
				} catch (e) {
					// No partial results: a WASM load failure (WasmLoadError,
					// shown by the loading bar) or any other error leaves the
					// results hidden and says so.
					results.classList.remove('visible');
					if (e instanceof WasmLoadError) {
						status.textContent = '';
					} else {
						console.error('Citation check failed:', e);
						status.classList.add('check-error');
						status.textContent = 'Error: ' + e.message;
					}
				} finally {
					btn.disabled = false;
				}
			});

			// Fetch and compile the WASM in the background once the page has
			// painted; the check button waits on it only if it isn't ready.
			preloadWasm();
		</script>
		<script is:inline>
			(function() {
				var btn = document.getElementById('page-theme-btn');
				if (!btn) return;
				try { if (localStorage.getItem('stare-theme') === 'dark' || (!localStorage.getItem('stare-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) btn.textContent = '\u2600'; } catch(e) {}
				btn.addEventListener('click', function(e) {
					e.preventDefault();
					var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
					if (isDark) { document.documentElement.removeAttribute('data-theme'); btn.textContent = '\u263E'; try { localStorage.setItem('stare-theme', 'light'); } catch(e) {} }
					else { document.documentElement.setAttribute('data-theme', 'dark'); btn.textContent = '\u2600'; try { localStorage.setItem('stare-theme', 'dark'); } catch(e) {} }
				});
			})();
		</script>
	</body>
</html>
