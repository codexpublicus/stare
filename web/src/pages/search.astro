---
import SiteFooter from '../components/SiteFooter.astro';
import { BOOT_TIMEOUT_MS, bootGuardScript } from '../lib/bootguard.js';
import '../styles/theme.css';
import '../styles/layout.css';
import '../styles/search.css';
import Brand from '../components/Brand.astro';
import SiteHead from '../components/SiteHead.astro';

// A search tree to read instead of the live index's (`http://127.0.0.1:8765/v/<version>/search`),
// for the dev server and local measurements; release and preview builds leave it unset.
const tree = import.meta.env.PUBLIC_SEARCH_TREE || '';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<SiteHead />
		<title>Search case law · stare.pub</title>
		<meta name="description" content="Search the text of U.S. court decisions on stare.pub, in your browser, from static files." />
		<meta property="og:title" content="Search case law · §tare.pub" />
		<meta property="og:description" content="Search the text of U.S. court decisions from the Caselaw Access Project and CourtListener, in your browser." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://stare.pub/search" />
		<meta property="og:image" content="https://stare.pub/og-image.png" />
		<script is:inline>
			try {
				var theme = localStorage.getItem('stare-theme');
				if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			} catch(e) {}
		</script>
		<!-- If the page's module fails to load, say so (#265). -->
		<script is:inline set:html={bootGuardScript({ targets: ['search-status'], what: 'Search', errorClass: 'search-error', timeout: BOOT_TIMEOUT_MS })}></script>
	</head>
	<body data-search-tree={tree}>
		<div class="page-topbar"><a href="/"><Brand /></a><button class="page-theme-toggle" id="page-theme-btn" title="Toggle dark mode">&#9790;</button></div>
		<main class="search-page">
			<h1>Search case law</h1>
			<form id="search-form" class="search-form" role="search" action="/search/" method="get">
				<label for="search-q" class="search-label">Words in the decision or its name, or a citation</label>
				<div class="search-row">
					<input id="search-q" name="q" type="search" autocomplete="off" spellcheck="false" maxlength="500" placeholder="palsgraf railroad" aria-describedby="search-help" />
					<!-- One button for both (D163): its label follows the text, a citation or words (boxroute.js). -->
						<button type="submit" id="search-btn" class="route-btn" data-goes="search"><span class="route-label route-search">Search</span><span class="route-label route-cite">Open citation</span></button>
				</div>
				<p id="search-help" class="search-help">Finds decisions with every word, in the opinion text or the case name. Words are matched as written: <i>negligent</i> doesn&rsquo;t find <i>negligence</i>.</p>
				<span id="search-route-status" class="sr-only" aria-live="polite"></span>
				<details id="search-filters" class="search-filters">
					<summary>Filters<span id="search-filter-count" class="search-filter-count"></span></summary>
					<div class="search-filter-panel">
						<label class="search-field search-field-jur">
							<span>Jurisdiction</span>
							<select id="search-jurisdiction" name="jurisdiction"><option value="">Any</option></select>
						</label>
						<div class="search-field search-field-court">
							<label for="search-court">Court</label>
							<input id="search-court-find" class="search-court-find" type="search" autocomplete="off" spellcheck="false" placeholder="Type to narrow the list" aria-label="Narrow the court list" aria-controls="search-court" hidden />
							<select id="search-court" name="court"><option value="">Any</option></select>
						</div>
						<fieldset class="search-years">
							<legend>Decided</legend>
							<div id="search-year-chart" class="search-year-chart" aria-hidden="true"></div>
							<div class="search-year-inputs">
								<label class="search-field"><span>From year</span><input id="search-from" name="from" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off" /></label>
								<span class="search-year-dash" aria-hidden="true">to</span>
								<label class="search-field"><span>To year</span><input id="search-to" name="to" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off" /></label>
							</div>
						</fieldset>
						<div class="search-filter-actions">
							<button type="submit" class="search-apply">Apply</button>
							<button type="button" id="search-clear" class="search-clear" hidden>Clear filters</button>
						</div>
					</div>
					<p id="search-filter-note" class="search-filter-note"></p>
				</details>
				<ul id="search-chips" class="search-chips" aria-label="Filters in use" hidden></ul>
			</form>

			<p id="search-cite" class="search-cite" hidden></p>
			<p id="search-status" class="search-status"></p>
			<div id="search-live" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
			<div class="search-results-wrap">
				<div id="search-progress" class="search-progress" hidden></div>
				<h2 id="search-results-heading" class="sr-only" tabindex="-1">Results</h2>
				<p id="search-note" class="search-note" hidden></p>
				<ol id="search-results" class="search-results" aria-labelledby="search-results-heading"></ol>
				<div id="search-empty" class="search-empty" hidden></div>
			</div>
			<nav id="search-pages" class="search-pages" aria-label="Result pages" hidden></nav>
			<noscript><p class="search-help">Search runs in your browser and needs JavaScript.</p></noscript>
		</main>
		<SiteFooter />
		<script is:inline type="module" src="/js/searchpage.js"></script>
		<script is:inline>
			(function() {
				var btn = document.getElementById('page-theme-btn');
				if (!btn) return;
				try { if (localStorage.getItem('stare-theme') === 'dark' || (!localStorage.getItem('stare-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) btn.textContent = '☀'; } catch(e) {}
				btn.addEventListener('click', function(e) {
					e.preventDefault();
					var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
					if (isDark) { document.documentElement.removeAttribute('data-theme'); btn.textContent = '☾'; try { localStorage.setItem('stare-theme', 'light'); } catch(e) {} }
					else { document.documentElement.setAttribute('data-theme', 'dark'); btn.textContent = '☀'; try { localStorage.setItem('stare-theme', 'dark'); } catch(e) {} }
				});
			})();
		</script>
	</body>
</html>
