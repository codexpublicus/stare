/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# citare's data bundle (#117). The name is the content's SHA-256 prefix, so a
# URL never changes content and browsers keep it for good. Cloudflare doesn't
# compress application/octet-stream, the default for .bin, and the bundle is
# 422 KB raw against about 100 KB compressed; x-protobuf is on its list of
# compressible types and is the nearest kind of file (varint-coded tables).
# The loader reads the bytes and ignores the type.
/data/citare/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/x-protobuf
