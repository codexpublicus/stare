/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# citare's data bundle (#117), gzipped by the build. The name is the
# uncompressed bundle's SHA-256 prefix, so a URL never changes content and
# browsers keep it for good. Served as the gzip file it is, with no
# Content-Encoding: Cloudflare doesn't compress application/gzip again, the
# browser doesn't decompress it on the way in, and the loader gunzips it with
# DecompressionStream.
#
# Next to each bundle is its sidecar, citare-data-<hash>.json: the bundle's
# licence and the reporters-db and courts-db sections with their licences and
# notices (D65). Its name has the same hash, so it's immutable too, and it's
# served as JSON. A request matching both rules gets both rules' headers, so
# the content types are set per extension and only Cache-Control is shared.
/data/citare/*
  Cache-Control: public, max-age=31536000, immutable
/data/citare/*.gz
  Content-Type: application/gzip
/data/citare/*.json
  Content-Type: application/json; charset=utf-8

# The crawler files (#171, #161). llms.txt is UTF-8 Markdown with a few
# non-ASCII characters; say so, so no client guesses Latin-1.
/robots.txt
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# PDF.js for the Archival PDF view (src/lib/pdfjs-vendor.js). The directory is named for
# the pdfjs-dist version and our worker patch's revision (public/js/pdfjs-path.js), so a
# URL never changes content.
/vendor/pdfjs-*
  Cache-Control: public, max-age=31536000, immutable

# The search page's client (src/lib/searchvendor.js), likewise named for the index builder
# and RoaringBuckets client commits it was bundled from (public/js/searchclient-path.js).
/vendor/stare-search-*
  Cache-Control: public, max-age=31536000, immutable

# Long caching for everything whose URL changes when its content does (#266), and
# nothing else. Every other file keeps Workers' default, public, max-age=0,
# must-revalidate: the pages, /js/*.js (plain names that import each other, so a
# long max-age would let a browser mix two deployments' modules), the fonts, the
# un-hashed /wasm/ files and stare_wasm_bg.json, reporters.json and the crawler
# files. Don't add a rule here for a file whose name doesn't change with it.
#
# Astro's build output: Vite names each file for its content hash.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The WASM module and its glue under content-hashed names, which the build copies
# them to and points the built /js/wasm.js at (src/lib/assetcache.js). The plain
# stare_wasm_bg.wasm and stare_wasm.js don't match these patterns.
/wasm/stare_wasm_bg.*.wasm
  Cache-Control: public, max-age=31536000, immutable
/wasm/stare_wasm.*.js
  Cache-Control: public, max-age=31536000, immutable
