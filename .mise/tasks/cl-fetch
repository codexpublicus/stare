#!/usr/bin/env bash
#MISE description="Fetch a CourtListener bulk export into $STARE_CL_DIR/<date>/ (resumable; pipelines/courtlistener)"
#USAGE flag "--date <date>" help="The export date, YYYY-MM-DD, or latest (the newest complete export)" default="latest"
#USAGE flag "--dest <dir>" help="The mirror root (default: $STARE_CL_DIR)"
#USAGE flag "--tables <tables>" help="Space-separated tables (default: opinion-clusters opinions dockets citations)"
set -euo pipefail

# Runs `stare-cl fetch`: each table downloads to <dest>/<date>/<table>-<date>.csv.bz2 by way
# of a .part file, a rerun resumes it, and <dest>/<date>/export.json records each file's
# size, ETag and SHA-256. The four default tables come to about 63 GB, opinions alone 55 GB.
# Check the result with `uv --directory pipelines/courtlistener run stare-cl verify`.
# See pipelines/courtlistener/RUNBOOK.md.

dir="${MISE_PROJECT_ROOT}/pipelines/courtlistener"
dest="${usage_dest:-${STARE_CL_DIR:-}}"
if [ -z "$dest" ]; then
  echo "cl-fetch: set STARE_CL_DIR (or pass --dest) to the directory the exports go in" >&2
  exit 2
fi

tables=()
if [ -n "${usage_tables:-}" ]; then
  # word splitting is intended: one table per word
  # shellcheck disable=SC2206
  tables=(--tables ${usage_tables})
fi

uv --directory "$dir" sync --locked --quiet
exec uv --directory "$dir" run --locked stare-cl fetch --date "${usage_date:-latest}" --dest "$dest" "${tables[@]}"
