#!/usr/bin/env bash
#MISE description="Build stare-cl from a git ref on this host and run fetch, stage, text and records in it (operator-run, on ml-01)"
#USAGE arg "<ref>" help="The git ref (commit, branch or tag) to build the image from"
#USAGE flag "--index <version>" help="The index build to classify against, codexpublicus-index:/builds/<version>/ (required unless --index-dir)"
#USAGE flag "--date <date>" help="The export date, YYYY-MM-DD, or latest (needs the fetch step)" default="latest"
#USAGE flag "--steps <steps>" help="Space-separated steps to run, in order" default="fetch stage text records"
#USAGE flag "--data-dir <dir>" help="Bind-mount this directory as the export root instead of the codexpublicus-courtlistener volume (for tests)"
#USAGE flag "--index-dir <dir>" help="Bind-mount this directory as the index build instead of codexpublicus-index (for tests)"
set -euo pipefail

# Builds pipelines/courtlistener/Dockerfile from <ref> in a throwaway worktree, on this
# host (tagged stare-cl:<short sha> and stare-cl:local, never pushed anywhere), then runs
# the steps in one container:
#
#   fetch    the export's tables into /data/<date>/ (resumable; the only step with network)
#   stage    stage.sqlite, classified by page against the index build, mounted read-only
#   text     text.sqlite from opinions (restarted whenever stage ran in the same call)
#   records  /data/out/cl/..., with the delta against the newest earlier export in
#            /data/out/cl/exports/
#
# /data is the codexpublicus-courtlistener volume and the index is codexpublicus-index,
# mounted :ro; both must already exist. The run stops if the index build lacks any .bin
# file its manifest lists, since those volumes would be judged by volume, not by page.
# See pipelines/courtlistener/RUNBOOK.md.

root="${MISE_PROJECT_ROOT}"
ref="${usage_ref:?}"
date="${usage_date:-latest}"
steps="${usage_steps:-fetch stage text records}"
data_volume=codexpublicus-courtlistener
index_volume=codexpublicus-index

die() { echo "cl-build: $*" >&2; exit 1; }

for step in $steps; do
  case "$step" in fetch | stage | text | records) ;; *) die "unknown step $step" ;; esac
done
if [ "$date" = latest ] && [[ " $steps " != *" fetch "* ]]; then
  die "--date latest needs the fetch step; give the export date"
fi

mounts=()
if [ -n "${usage_data_dir:-}" ]; then
  [ -d "$usage_data_dir" ] || die "no directory $usage_data_dir"
  mounts+=(-v "$(realpath "$usage_data_dir"):/data")
else
  docker volume inspect "$data_volume" >/dev/null 2>&1 \
    || die "docker volume $data_volume doesn't exist; create it (the TrueNAS export dataset) first"
  mounts+=(-v "$data_volume:/data")
fi
if [ -n "${usage_index_dir:-}" ]; then
  [ -f "$usage_index_dir/manifest.json" ] || die "$usage_index_dir has no manifest.json"
  mounts+=(-v "$(realpath "$usage_index_dir"):/index-build:ro")
  index_path=/index-build
elif [[ " $steps " == *" stage "* ]]; then
  [ -n "${usage_index:-}" ] || die "give --index <version> (an index build) for the stage step"
  docker volume inspect "$index_volume" >/dev/null 2>&1 || die "docker volume $index_volume doesn't exist"
  mounts+=(-v "$index_volume:/index:ro")
  index_path="/index/builds/${usage_index}"
else
  index_path=
fi

# the image, from <ref>, in a throwaway worktree
git -C "$root" fetch --quiet origin
commit="$(git -C "$root" rev-parse --verify --quiet "$ref^{commit}" \
  || git -C "$root" rev-parse --verify --quiet "origin/$ref^{commit}")" \
  || die "no commit for $ref"
work="$(mktemp -d "${TMPDIR:-/tmp}/stare-cl-build.XXXXXX")"
cleanup() {
  git -C "$root" worktree remove --force "$work/src" 2>/dev/null || true
  rm -rf "$work"
}
trap cleanup EXIT
git -C "$root" worktree add --quiet --detach "$work/src" "$commit"
image="stare-cl:${commit:0:12}"
docker build --quiet --build-arg COMMIT="$commit" --tag "$image" --tag stare-cl:local \
  "$work/src/pipelines/courtlistener"

if [ -n "$index_path" ]; then
  docker run --rm --network none "${mounts[@]}" --entrypoint test "$image" \
    -f "$index_path/manifest.json" || die "no index build at $index_path (no manifest.json)"
fi

network=(--network none)
[[ " $steps " == *" fetch "* ]] && network=()

echo "Running $steps for $date with $image ($commit)"
docker run --rm --init --user 1000:1000 "${network[@]}" "${mounts[@]}" \
  -e DATE="$date" -e STEPS="$steps" -e INDEX="$index_path" \
  --entrypoint bash "$image" -c '
    set -euo pipefail
    if [ "$DATE" = latest ]; then
      DATE="$(stare-cl dates | head -n 1 | cut -d " " -f 1)"
      [ -n "$DATE" ] || { echo "no complete export in the bucket" >&2; exit 1; }
    fi
    echo "export $DATE"
    restart=()
    for step in $STEPS; do
      echo "== $step"
      case "$step" in
        fetch) stare-cl fetch --date "$DATE" --dest /data ;;
        stage)
          stare-cl stage --date "$DATE" --dest /data --index-dir "$INDEX"
          python3 -c "
import json, sys
r = json.load(open(\"/data/$DATE/stage-report.json\"))
if r[\"level\"] != \"page\" or r.get(\"index_files_missing\"):
    sys.exit(\"stage: the index build is incomplete; %s .bin files missing\" % r.get(\"index_files_missing\"))
"
          restart=(--restart) ;;
        text) stare-cl text --date "$DATE" --dest /data "${restart[@]}" ;;
        records)
          previous=()
          if [ -d /data/out/cl/exports ]; then
            prev="$(ls /data/out/cl/exports | awk -v d="$DATE" "\$0 < d" | sort | tail -n 1)"
            [ -n "$prev" ] && previous=(--previous "/data/out/cl/exports/$prev")
          fi
          stare-cl records --date "$DATE" --dest /data --out /data/out "${previous[@]}" ;;
      esac
    done
  '
