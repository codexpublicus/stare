#!/usr/bin/env bash
#MISE description="Run Pulumi on infra/ with the state-backend and infra Cloudflare credentials"
#USAGE arg "[args]..." var=#true help="Arguments passed through to pulumi"
set -euo pipefail

# stare's own AWS_* keys are the s5cmd R2 token for stare-pub-idx, and its
# CLOUDFLARE_API_TOKEN is the hand-made Pages token, which can't list API token
# permission groups. Pulumi gets the state backend's keys and the org infra token.
AWS_ACCESS_KEY_ID="$PULUMI_STATE_AWS_ACCESS_KEY_ID" \
AWS_SECRET_ACCESS_KEY="$PULUMI_STATE_AWS_SECRET_ACCESS_KEY" \
CLOUDFLARE_API_TOKEN="$PULUMI_CLOUDFLARE_API_TOKEN" \
  exec pulumi -C "$MISE_PROJECT_ROOT/infra" "$@"
