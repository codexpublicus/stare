#!/usr/bin/env bash
#MISE description="Compare the vendored search client with its pinned commits, and say whether the index builder's main has changed it since"
#USAGE flag "--ref <ref>" help="The index builder ref to compare the pin with" default="origin/main"
set -euo pipefail

# The search page's clients are vendored byte for byte (web/src/lib/searchvendor.js):
# the index builder's pipelines/search-index/client/{search,tokenize}.mjs, one copy per
# search format (web/src/vendor/stare-search/ for format 3, stare-search-format2/ for
# format 2), and the RoaringBuckets client's packages/client/src, at the commits
# web/src/vendor/search-client.json pins. Both repositories are private, so CI can't run
# this; it clones them with your git credentials from the GitHub `owner/name` in
# SEARCH_CLIENT_REPO (the index builder) and RB_CLIENT_REPO (the RoaringBuckets client),
# which you set in your own environment. It fails if a copy differs from its pinned commit,
# and lists the files the index builder changed between the newest pin (stare-search) and
# --ref, which mean that pin is behind.
: "${SEARCH_CLIENT_REPO:?set SEARCH_CLIENT_REPO to the index builder's GitHub owner/name}"
: "${RB_CLIENT_REPO:?set RB_CLIENT_REPO to the RoaringBuckets client's GitHub owner/name}"
root="${MISE_PROJECT_ROOT}"
vendor="$root/web/src/vendor"
ref="${usage_ref:-origin/main}"
pins="$vendor/search-client.json"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

pin() { node -e "const p=require('$pins'); console.log(p['$1'].$2)"; }
files() { node -e "console.log(Object.keys(require('$pins')['$1'].files).join(' '))"; }
# the stare-search pins, one per search format
clients() { node -e "const p=require('$pins'); console.log(Object.keys(p).filter((k) => p[k].format_version !== undefined).join(' '))"; }

git -c url."https://github.com/".insteadOf=git@github.com: clone --quiet --filter=blob:none \
  "https://github.com/$SEARCH_CLIENT_REPO.git" "$tmp/sb"
git -c url."https://github.com/".insteadOf=git@github.com: clone --quiet --filter=blob:none \
  "https://github.com/$RB_CLIENT_REPO.git" "$tmp/rb"

status=0
for dir in $(clients); do
  c="$(pin "$dir" commit)"
  cpath="$(pin "$dir" path)"
  for f in $(files "$dir"); do
    if ! git -C "$tmp/sb" show "$c:$cpath/$f" | cmp -s - "$vendor/$dir/$f"; then
      echo "$dir/$f differs from $c" >&2
      status=1
    fi
  done
done
sb_commit="$(pin stare-search commit)"
sb_path="$(pin stare-search path)"
rb_commit="$(pin roaringbuckets-client commit)"
rb_path="$(pin roaringbuckets-client path)"
for f in $(files roaringbuckets-client); do
  src="$rb_path/$f"
  [ "$f" = LICENSE ] && src=LICENSE
  if ! git -C "$tmp/rb" show "$rb_commit:$src" | cmp -s - "$vendor/roaringbuckets-client/$f"; then
    echo "roaringbuckets-client/$f differs from $rb_commit" >&2
    status=1
  fi
done
[ "$status" = 0 ] && echo "the vendored copies match their pins"

changed="$(git -C "$tmp/sb" diff --name-only "$sb_commit" "$ref" -- "$sb_path/search.mjs" "$sb_path/tokenize.mjs")"
if [ -n "$changed" ]; then
  echo "the index builder's $ref has changed the client since the pin:"
  echo "$changed"
else
  echo "the index builder's $ref has the pinned client"
fi
exit "$status"
